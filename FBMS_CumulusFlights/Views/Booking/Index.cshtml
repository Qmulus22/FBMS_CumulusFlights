@{
    ViewData["Title"] = "Flight Search";
    var isUserLoggedIn = User.Identity.IsAuthenticated;
}

<section class="py-16 bg-gray-100 min-h-screen flex justify-center">
    <div class="container mx-auto flex">
        <!-- Main Content Section -->
        <div class="w-full md:w-4/9 md:ml-4 md:pl-12">
            <h1 class="text-2xl font-bold text-black mb-6 text-center">Book Your Flights</h1>
            <!-- Flight Search Form -->
            <div class="bg-white p-6 rounded shadow-md mx-auto max-w-4xl">
                <form id="searchForm" asp-action="Index" method="get">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700">From (City/Airport Code)</label>
                            <input name="from" type="text" placeholder="Enter departure city or airport code" class="w-full p-3 border border-gray-300 rounded-md">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700">To (City/Airport Code)</label>
                            <input name="to" type="text" placeholder="Enter destination city or airport code" class="w-full p-3 border border-gray-300 rounded-md">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700">Departure Date</label>
                            <input name="departureDate" type="date" class="w-full p-3 border border-gray-300 rounded-md">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700">Max Budget (PHP)</label>
                            <input name="maxPrice" type="number" step="0.01" placeholder="Enter max price" class="w-full p-3 border border-gray-300 rounded-md">
                        </div>
                        <div class="col-span-2 lg:col-span-4">
                            <button type="submit" class="w-full bg-blue-900 text-white py-3 rounded-md text-lg search-flights-button">
                                Search Flights
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Flight Strip Section -->
            <div class="mt-8 space-y-4 w-full max-w-4xl mx-auto">
                @foreach (var flight in Model)
                {
                    <div class="bg-white p-6 rounded-lg shadow-md flex items-center relative overflow-hidden">
                        <!-- Flight Image with Gradient Overlay -->
                        <img id="flight-image-@flight.FlightId" alt="Flight Image" class="absolute left-0 top-0 h-full w-1/2 object-cover">
                        <div class="absolute left-0 top-0 h-full w-1/2 bg-gradient-to-r from-transparent to-white"></div>
                        <!-- Flight Info Section -->
                        <div class="flex-grow text-center relative z-10">
                            <h3 class="text-lg font-semibold text-black">@flight.OriginCity (@flight.OriginAirportCode) to @flight.DestinationCity (@flight.DestinationAirportCode)</h3>
                            <p class="text-sm text-black">Departure: @flight.DepartureDate.ToString("MMM dd, yyyy")</p>
                        </div>
                        <!-- Book Now Button -->
                        <div class="text-right z-10">
                            <p class="text-lg font-bold text-black">₱@flight.Price.ToString("N2")*</p>
                            <a href="#" class="bg-blue-900 text-white py-2 px-4 rounded mt-4 inline-block book-now" data-flight-id="@flight.FlightId">Book Now</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Login Modal -->
<div id="loginModal" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white p-6 rounded-lg shadow-lg w-1/3 text-center relative">
        <button id="closeModal" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700">&times;</button>
        <h2 class="text-xl font-semibold text-black mb-4">Log In or Sign Up</h2>
        <p class="text-gray-600 mb-4">You need to be logged in to search or book flights.</p>
        <div class="flex justify-center space-x-4">
            <a href="/Identity/Account/Login" class="bg-blue-900 text-white py-2 px-4 rounded">Log In</a>
            <a href="/Identity/Account/Register" class="bg-gray-300 text-gray-900 py-2 px-4 rounded">Sign Up</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let isLoggedIn = @Json.Serialize(isUserLoggedIn);

        document.querySelectorAll(".book-now, .search-flights-button").forEach(button => {
            button.addEventListener("click", function (event) {
                if (!isLoggedIn) {
                    event.preventDefault();
                    document.getElementById("loginModal").classList.remove("hidden");
                } else if (button.classList.contains("book-now")) {
                    window.location.href = `/Booking/BookingSummary?flightId=${button.dataset.flightId}`;
                }
            });
        });

        document.getElementById("closeModal").addEventListener("click", function () {
            document.getElementById("loginModal").classList.add("hidden");
        });

        window.onload = function () {
            document.querySelectorAll("[id^='flight-image-']").forEach(img => {
                img.src = getRandomImagePath();
            });
        };
    });

    function getRandomImagePath() {
        const imagePaths = [
             "/Images/China.jpg",
            "/Images/Bohol.jpg",
            "/Images/LandMark1.jpg",
            "/Images/LandMark2.jpg",
                "/Images/LandMark3.jpg",
            "/Images/LandMark4.jpg",
            "/Images/LandMark5.jpg",
                "/Images/LandMark6.jpg",
                "/Images/LandMark7.jpg",
                        "/Images/LandMark8.jpg",
                    "/Images/LandMark9.jpg",
                    "/Images/LandMark10.jpg",
        ];
        const randomIndex = Math.floor(Math.random() * imagePaths.length);
        return imagePaths[randomIndex];
    }
</script>

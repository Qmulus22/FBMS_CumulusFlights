@model FBMS_CumulusFlights.Models.ViewModels.UserDetailsViewModel

<div>
    <p><strong>First Name:</strong> @Model.FirstName</p>
    <p><strong>Last Name:</strong> @Model.LastName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
    <p><strong>Date of Birth:</strong> @Model.FormattedDateOfBirth</p>
    <p><strong>Gender:</strong> @Model.Gender</p>
    <p><strong>Nationality:</strong> @Model.Nationality</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>User Type:</strong> @Model.UserType</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Date Joined:</strong> @Model.DateJoined</p>
</div>

@using FBMS_CumulusFlights.ViewModel
@using FBMS_CumulusFlights.Models.Enums

@model FBMS_CumulusFlights.ViewModel.ApproveFlightsViewModel

@{
    Layout = "_AdminLayout";
}

<style>
    .approve-flights-container {
        max-width: 1500px;
        margin: 0 auto;
        padding: 2rem;
        margin-left: 3rem;
    }

    .flight-filter {
        background: #fff;
        padding: 2rem;
        border-radius: 12px;
        margin: 0 auto 2.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        width: 100%;
        max-width: 1400px;
    }

    .approve-flights-table {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        margin: 2.5rem auto;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .table {
        width: 100%;
        margin: 0;
    }

        .table th,
        .table td {
            padding: 1.25rem 2rem;
            font-size: 1.05rem;
            text-align: left;
        }

    .btn {
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
        width: 100%; /* Make buttons full width */
    }

    h2 {
        margin-bottom: 2rem;
    }

    .btn-sm {
        padding: 0.5rem 2rem !important;
        font-size: 0.9rem !important;
        min-width: 80px;
    }

    .d-flex.gap-2 {
        gap: 0.5rem;
    }

    .form-inline {
        display: inline-block;
        margin: 0 2px;
    }
</style>

<div class="container-fluid approve-flights-container">
    <h2>Approve Flights from API Source</h2>
    <div class="flight-filter">
        <form method="get" class="row justify-content-center">
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Flight Number</label>
                <input type="text" name="FlightNumber" class="form-control" placeholder="Enter Flight Number" value="@Model.SearchModel.FlightNumber" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">From (City/Airport Code/Name)</label>
                <input type="text" name="From" class="form-control" placeholder="Departure Airport" value="@Model.SearchModel.From" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">To (City/Airport Code/Name)</label>
                <input type="text" name="To" class="form-control" placeholder="Destination Airport" value="@Model.SearchModel.To" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Max Price (PHP)</label>
                <input type="number" name="MaxPrice" class="form-control" placeholder="Enter Max Price" value="@Model.SearchModel.MaxPrice" min="0" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Departure Date</label>
                <input type="date" name="DepartureDate" class="form-control" value="@Model.SearchModel.DepartureDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Departure Time Range</label>
                <div class="input-group">
                    <input type="time" name="DepartureTimeStart" class="form-control" placeholder="Start Time" value="@Model.SearchModel.DepartureTimeStart?.ToString(@"hh\:mm")" />
                    <span class="input-group-text">to</span>
                    <input type="time" name="DepartureTimeEnd" class="form-control" placeholder="End Time" value="@Model.SearchModel.DepartureTimeEnd?.ToString(@"hh\:mm")" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 align-self-end mb-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-2"></i>Search Flights
                </button>
            </div>
        </form>
    </div>

    <div class="approve-flights-table">
        <table class="table table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Flight #</th>
                    <th>Departure</th>
                    <th>Destination</th>
                    <th>Departure Date</th>
                    <th>Flight Duration (hrs)</th>
                    <th>Distance (km)</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flight in Model.Flights.Where(f => f.ApprovalStatus == ApprovalStatus.Pending && !f.IsDeleted))
                {
                    <tr>
                        <td>@flight.FlightNumber</td>
                        <td>
                            @flight.OriginAirportName (@flight.OriginAirportCode)<br>
                            <small>@flight.OriginCity</small>
                        </td>
                        <td>
                            @flight.DestinationAirportName (@flight.DestinationAirportCode)<br>
                            <small>@flight.DestinationCity</small>
                        </td>
                        <td>@flight.DepartureDate.ToString("MMM dd, yyyy")</td>
                        <td>@flight.FlightDuration.ToString("N2")</td>
                        <td>@flight.DistanceKm.ToString("N0")</td>
                        <td>₱@flight.Price.ToString("N2")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form method="post" asp-action="ApproveFlight" class="approve-form">
                                    <input type="hidden" name="id" value="@flight.FlightId" />
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-success btn-sm approve-btn">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                </form>
                                <form method="post" asp-action="RejectFlight" class="reject-form">
                                    <input type="hidden" name="id" value="@flight.FlightId" />
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-danger btn-sm reject-btn">
                                        <i class="fas fa-times"></i> Reject
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.querySelectorAll('.approve-btn').forEach(button => {
        button.addEventListener('click', function () {
            const form = this.closest('.approve-form');
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to approve this flight?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, approve it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); // Submit the form if confirmed
                }
            });
        });
    });

    document.querySelectorAll('.reject-btn').forEach(button => {
        button.addEventListener('click', function () {  
            const form = this.closest('.reject-form');
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to reject this flight?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, reject it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); // Submit the form if confirmed
                }
            });
        });
    });
</script>
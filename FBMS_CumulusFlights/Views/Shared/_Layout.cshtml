<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cumulus Flights</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.paypal.com/sdk/js?client-id=Adek5x6NtvUCIUE_Y7zWIs2CRPD9Rvhr5ZCqtBWIEml2OfGFSCCV9RzAACa9nEXhhribhwal6alo6nJp"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="font-sans bg-gray-100">
    <!-- Main Navigation -->
    <div class="bg-blue-800 sticky top-0 z-50 shadow-lg">
        <div class="container mx-auto flex justify-between items-center py-4 px-6">
            <!-- Logo -->
            <div class="flex items-center">
                <img src="/Images/CompanyLogo.png" alt="Cumulus Flights Logo" class="h-10 mr-3" width="70" height="130" />
                <div>
                    <div class="text-2xl font-bold text-white tracking-wide">Cumulus Flights</div>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="flex items-center space-x-6 text-white text-lg font-medium">
                <a asp-controller="Home" asp-action="Index" class="hover:text-gray-200 transition">Home</a>
                <a asp-controller="Home" asp-action="About" class="hover:text-gray-200 transition">About</a>
                <a asp-controller="Booking" asp-action="Index" class="hover:text-gray-200 transition">Flights</a>
               @*  <a asp-controller="Flight" asp-action="Index" class="hover:text-gray-200 transition">Flights</a> *@

                <!-- Authentication Links -->
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>

  
        <main role="main" class="pb-3">
            @RenderBody()


        </main>
    

    <!-- Footer -->
    <footer class="bg-blue-800 text-white text-center py-4 mt-8">
        <div class="container mx-auto">
            <p>
                &copy; 2025 Cumulus Flights. All rights reserved.
                <a asp-controller="Home" asp-action="Privacy" class="text-white hover:text-gray-200 ml-4">Privacy</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

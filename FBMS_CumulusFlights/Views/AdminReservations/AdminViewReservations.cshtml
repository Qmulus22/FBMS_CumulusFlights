@model List<FBMS_CumulusFlights.Models.Reservation>
@{
    Layout = "_AdminLayout";
}

<style>
    /* Main container for the view reservations section */
    .view-reservations-container {
        max-width: 1500px;
        margin: 0 auto;
        padding: 2rem;
        margin-left: 3rem; /* Adjusted left margin */
    }

    /* Styled filter section */
    .reservations-filter {
        background: #fff;
        padding: 2rem;
        border-radius: 12px;
        margin: 0 auto 2.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 1400px;
    }

    /* Styled table */
    .reservations-table {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        margin: 2.5rem auto;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .table {
        width: 100%;
        margin: 0;
    }

        .table th,
        .table td {
            padding: 1.25rem 2rem;
            font-size: 1.05rem;
            text-align: left; /* Left-align the text */
        }

    /* Button styles */
    .btn {
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
    }

    /* Heading style */
    h2 {
        margin-bottom: 2rem; /* Added margin to create space between heading and search section */
    }

    /* Modal styles */
    .modal {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto; /* 15% from the top and centered */
        padding: 20px;
        border: 1px solid #888;
        width: 50%; /* Could be more or less, depending on screen size */
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .modal-content {
        background-color: #fefefe;
        margin: 10% auto; /* Center the modal */
        padding: 20px;
        border: 1px solid #888;
        width: 600px; /* Could be more or less, depending on screen size */
        border-radius: 10px; /* Rounded corners */
    }

    .modal-header {
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .modal-header h2 {
            margin: 0;
        }

    .modal-body {
        text-align: left; /* Align text to the left */
    }

        .modal-body p {
            margin: 5px 0; /* Add some spacing between paragraphs */
        }

    .modal-footer {
        display: flex;
        justify-content: center;
    }

    .view-icon {
        font-size: 1.5rem; /* Adjust icon size */
        cursor: pointer; /* Change cursor to pointer */
    }
</style>

<div class="container-fluid view-reservations-container">
    <h2>View Reservations</h2>
    <!-- Reservations Filter Section -->
    <div class="reservations-filter">
        <form method="get" class="row justify-content-center">
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Reservation ID</label>
                <input type="text" class="form-control" placeholder="Enter Reservation ID" name="reservationId" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Flight ID</label>
                <input type="text" class="form-control" placeholder="Enter Flight ID" name="flightId" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Traveler Name</label>
                <input type="text" class="form-control" placeholder="Enter Traveler Name" name="travelerName" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Status</label>
                <select class="form-control" name="status">
                    <option value="">Select Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Canceled">Canceled</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" name="startDate" />
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <label class="form-label">End Date</label>
                <input type="date" class="form-control" name="endDate" />
            </div>
      
            <div class="col-lg-3 col-md-6 align-self-end mb-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-2"></i>Search Reservations
                </button>
            </div>
        </form>
    </div>

    <div class="reservations-table">
        <table class="table table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Reservation ID</th>
                    <th>Traveler Name</th>
                    <th>Flight Origin</th>
                    <th>Flight Destination</th>
                    <th>Reservation Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Payment Method</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var reservation in Model)
                    {
                        var travelers = reservation.Tickets?.Select(t => t.Traveler).ToList();
                        var payment = reservation.Payments?.FirstOrDefault();
                        var flight = reservation.Flight; // Get flight details

                        <tr>
                            <td>@reservation.ReservationId</td>
                            <td>@string.Join(", ", travelers?.Select(t => $"{t.FirstName} {t.LastName}"))</td>
                            <td>@flight?.OriginCity</td>
                            <td>@flight?.DestinationCity</td>
                            <td>@reservation.ReservationDate.ToShortDateString()</td>
                            <td>@reservation.TotalAmount.ToString("C")</td>
                            <td>@reservation.Status</td>
                            <td>@payment?.PaymentMethod</td>
                            <td>
                                <i class="fas fa-eye view-icon" onclick="openModal(
                                '@reservation.ReservationId',
                                '@string.Join(", ", travelers?.Select(t => $"{t.FirstName} {t.LastName}"))',
                                '@flight?.FlightNumber',
                                '@flight?.OriginCity - @flight?.OriginAirportCode',
                                '@flight?.DestinationCity - @flight?.DestinationAirportCode',
                                '@flight?.DepartureDate.ToString("g")',
                                '@reservation.ReservationDate.ToShortDateString()',
                                '@reservation.TotalAmount.ToString("C")',
                                '@reservation.Status',
                                '@payment?.PaymentMethod'
                            )"></i>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No reservations found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Structure -->
<div id="reservationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Reservation Details</h2>
            @* <span class="close" onclick="closeModal()">&times;</span> *@
        </div>
        <div class="modal-body" id="modalContent">
            <!-- Dynamic content will be inserted here -->
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal()">Close</button>
        </div>
    </div>
</div>

<script>
    function openModal(
        reservationId, travelerNames, flightNumber, origin, destination, departureDate, reservationDate, totalAmount, status, paymentMethod, ticketDetails) {
        const modalContent = `
                <p><strong>Reservation ID:</strong> ${reservationId}</p>
            <p><strong>Travelers:</strong> ${travelerNames}</p>
            <p><strong>Flight Number:</strong> ${flightNumber}</p>
            <p><strong>Origin:</strong> ${origin}</p>
            <p><strong>Destination:</strong> ${destination}</p>
                <p><strong>Departure Date:</strong> ${departureDate}</p>
            <p><strong>Reservation Date:</strong> ${reservationDate}</p>
            <p><strong>Total Amount:</strong> ${totalAmount}</p>
            <p><strong>Status:</strong> ${status}</p>
            <p><strong>Payment Method:</strong> ${paymentMethod}</p>
                <p><strong>Ticket Details:</strong> ${ticketDetails}</p>
        `;
        document.getElementById('modalContent').innerHTML = modalContent;
        document.getElementById('reservationModal').style.display = "block";
    }

    function closeModal() {
        document.getElementById('reservationModal').style.display = "none";
    }

        // Close modal when clicking outside of it
    window.onclick = function(event) {
        const modal = document.getElementById('reservationModal');
        if (event.target == modal) {
            closeModal();
    }
    }
</script>
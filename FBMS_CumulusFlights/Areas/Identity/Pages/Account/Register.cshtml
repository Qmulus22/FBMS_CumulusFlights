@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    .register-page {
        background: rgba(243, 244, 246, 0.3); /* Light gray with 30% opacity */
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 2rem;
    }

    .register-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        padding: 2.5rem;
        width: 100%;
        max-width: 900px; /* Wider card for better spacing */
        text-align: center;
    }

        .register-card img {
            width: 80px; /* Smaller logo */
            margin-bottom: 1rem; /* Reduced space below the logo */
        }

        .register-card h2 {
            font-size: 1.75rem;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 0.5rem;
        }

        .register-card p {
            color: #718096;
            margin-bottom: 2rem;
        }

    .form-group {
        margin-bottom: 1.5rem; /* Consistent spacing between form fields */
        text-align: left; /* Align labels and inputs to the left */
    }

        .form-group label {
            display: block; /* Ensure labels are above inputs */
            font-weight: 500;
            color: #4a5568;
            margin-bottom: 0.5rem;
        }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

    .btn-primary {
        width: 100%;
        padding: 0.75rem;
        background-color: #3b82f6;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #2563eb;
        }

    .text-danger {
        font-size: 0.875rem;
        color: #e53e3e;
    }

    .text-center a {
        color: #3b82f6;
        text-decoration: none;
        font-size: 0.875rem;
    }

        .text-center a:hover {
            text-decoration: underline;
        }
</style>

<div class="register-page">
    <div class="register-card">
        <div class="text-center">
            <img src="/Images/CompanyLogo.png" alt="Cumulus Flights Logo" class="mx-auto"> <!-- Centered logo -->
            <h2>Create Your Account</h2>
            <p>Sign up to book flights easily.</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-6">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <!-- First Name + Last Name -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.FirstName">First Name</label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="John" autocomplete="given-name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.LastName">Last Name</label>
                        <input asp-for="Input.LastName" class="form-control" placeholder="Doe" autocomplete="family-name" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Username + Email -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.Username">Username</label>
                        <input asp-for="Input.Username" class="form-control" placeholder="Choose a username" autocomplete="username" />
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Date of Birth + Gender -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.DateOfBirth">Date of Birth</label>
                        <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.Gender">Gender</label>
                        <select asp-for="Input.Gender" class="form-control">
                            <option value="" disabled selected>Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Input.Gender" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Nationality + Address -->
            <div class="form-group">
                <label asp-for="Input.Nationality">Nationality</label>
                <input asp-for="Input.Nationality" class="form-control" placeholder="e.g., American" />
                <span asp-validation-for="Input.Nationality" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Address">Address</label>
                <input asp-for="Input.Address" class="form-control" placeholder="Enter your address" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <!-- Phone Number -->
            <div class="form-group">
                <label asp-for="Input.PhoneNumber">Phone Number</label>
                <input asp-for="Input.PhoneNumber" type="tel" class="form-control" placeholder="+63 912 345 6789" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <!-- Password + Confirm Password -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.Password">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password"
                               minlength="12" pattern="^(?=.*\d)(?=.*[!#$%^&*(),.?':{}|<>]).{12,}$" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button id="registerSubmit" type="submit" class="btn btn-primary mt-4">
                Register
            </button>

            <p class="mt-4 text-center text-muted">
                Already have an account?
                <a asp-page="./Login" class="text-blue-600 hover:underline">Login here</a>
            </p>
        </form>
    </div>
</div>

<!-- SweetAlert for Success -->
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["SuccessMessage"]',
            showConfirmButton: true
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Page("/Index", new { area = "" })';
            }
        });
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}